# =============================================================================
# B6 — Autonomous PPC Cabinet env vars
# =============================================================================
# Скопируй в .env и заполни своими значениями.
# Файл .env в git НЕ коммитится (см. .gitignore).

# ---- LLM (Claude API) ---------------------------------------------------
# Стартуем с Sonnet 4.6. Получи ключ на console.anthropic.com.
ANTHROPIC_API_KEY=sk-ant-xxx
ANTHROPIC_DEFAULT_MODEL=claude-sonnet-4-6

# ---- Сервер -------------------------------------------------------------
AI_SERVER_HOST=0.0.0.0
AI_SERVER_PORT=8000
AI_SERVER_RELOAD=true

# ---- Google Ads API -----------------------------------------------------
# Developer token: ads.google.com/aw/apicenter (требует production approval для live аккаунтов)
GOOGLE_ADS_DEVELOPER_TOKEN=your_developer_token_here
GOOGLE_ADS_CLIENT_ID=your_client_id_here
GOOGLE_ADS_CLIENT_SECRET=your_client_secret_here

# OAuth для refresh token (тот же ClientID, обычно)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# MCC (manager) аккаунт-ID если используется
GOOGLE_ADS_MCC_ID=

# ---- Database -----------------------------------------------------------
# Dev: SQLite (файл рядом с проектом, ничего ставить не надо)
# Prod: Postgres (Hetzner managed или Supabase)
DATABASE_URL=sqlite:///./b6_dev.db
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/b6

# ---- Redis (для Celery, нужен в Week 2+) --------------------------------
# Dev: можно опустить, фоновые задачи будут падать (это нормально для Day 1)
REDIS_URL=redis://localhost:6379/0

# ---- Real-time (Socket.IO) ----------------------------------------------
# Секрет для подписи Socket.IO сессий
SOCKET_SECRET=change-me-in-production

# ---- Stripe (для биллинга, активируется на Week 3-4) --------------------
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ---- Email (Resend) -----------------------------------------------------
RESEND_API_KEY=your_resend_api_key_here

# ---- Safety / Limits ----------------------------------------------------
# Defaults для новых юзеров (можно override per-user в БД)
SAFETY_DAILY_SPEND_PCT_MAX=110
SAFETY_BID_CHANGE_PCT_MAX=30
SAFETY_ACTIONS_PER_HOUR_MAX=10

# ---- Misc ---------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
