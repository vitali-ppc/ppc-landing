# B6 Production environment template
# Скопируй в .env.prod и заполни на сервере. НЕ коммитить в git.

# === Anthropic ===
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_DEFAULT_MODEL=claude-sonnet-4-6

# === Database ===
POSTGRES_PASSWORD=сгенерируй_сильный_пароль_через_openssl_rand_base64_32

# === Google Ads ===
GOOGLE_ADS_USE_MOCK=false
GOOGLE_ADS_DEVELOPER_TOKEN=твой_developer_token
GOOGLE_CLIENT_ID=...apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...

# === Stripe ===
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_L1=price_...
STRIPE_PRICE_L2=price_...
STRIPE_PRICE_L3=price_...

# === Email ===
RESEND_API_KEY=re_...

# === Internal ===
# Секрет для server-to-server вызовов (frontend → backend)
B6_INTERNAL_SECRET=сгенерируй_через_openssl_rand_hex_32

# === CORS ===
CORS_ORIGINS=https://kampaio.com,https://www.kampaio.com
